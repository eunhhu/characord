DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# 비우면 지정 채널의 모든 사람이 사용 가능. 쉼표로 여러 ID 지정.
DISCORD_ALLOWED_USER_IDS=
DISCORD_REQUIRE_MENTION=false

# 기본값: Google Gemini API. 키는 Google AI Studio에서 발급.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=medium

# ChatGPT OAuth를 쓸 때 AI_PROVIDER=codex로 변경.
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
RESPONSE_TIMEOUT_MS=180000

# 기본값을 쓸 경우 아래 항목은 생략 가능.
CHARACTER_FILE=character.md
STATE_FILE=data/state.json
CODEX_WORKING_DIRECTORY=runtime
