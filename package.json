{
  "name": "discord-character-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small Discord character-chat bot backed by Codex ChatGPT OAuth.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.146.1",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  }
}
