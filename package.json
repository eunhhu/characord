{
  "name": "discord-character-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Small Discord character-chat bot backed by Gemini API or Codex OAuth.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "start": "bun src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "@openai/codex-sdk": "0.146.1",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
